# Caddy site blocks for VBS. Appended to the VPS's existing /etc/caddy/Caddyfile
# (which already serves ai.phhbr.de:8443) rather than replacing it — see
# docs/runbook.md for the one-time VPS setup that installs this.
#
# Both blocks are identical except for the release path and the Supabase
# project ref baked into connect-src. REPLACE_WITH_*_REF must be filled in
# with the real project ref before this is deployed — Supabase project refs
# are not secret (they're part of the public project URL), so they live here
# in plain text rather than as a secret.

vbs.bruchner.dev {
	root * /srv/vbs/production/current
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
		X-Frame-Options "DENY"
		Content-Security-Policy "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://REPLACE_WITH_PRODUCTION_REF.supabase.co wss://REPLACE_WITH_PRODUCTION_REF.supabase.co https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
	}

	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"

	try_files {path} /index.html
	file_server
}

vbs-staging.bruchner.dev {
	root * /srv/vbs/staging/current
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
		X-Frame-Options "DENY"
		Content-Security-Policy "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://REPLACE_WITH_STAGING_REF.supabase.co wss://REPLACE_WITH_STAGING_REF.supabase.co https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
	}

	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"

	try_files {path} /index.html
	file_server
}
