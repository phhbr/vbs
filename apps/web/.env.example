# Values printed by `supabase start`. Both are public by design — the anon key
# is a client-side key gated by RLS. Never put the service-role key here.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Cloudflare Turnstile site key (public). Left unset here — and in CI — so
# local dev and tests sign in anonymously with no captcha step at all.
# Staging and production set this in their own environment and enable
# matching bot protection in the Supabase Dashboard; see CLAUDE.md's
# Captcha section.
# VITE_TURNSTILE_SITE_KEY=

# Sentry DSN (public by design — it identifies where to send events, not a
# secret). Left unset here and in CI so local dev and tests report no errors
# anywhere. Staging and production set their own DSN; see CLAUDE.md's
# Monitoring section. initErrorTracking() disables Sentry entirely — no
# no-op client either — when this is unset.
# VITE_SENTRY_DSN=

# Buy Me a Coffee link (public — a plain URL, not a secret). Left unset here
# and in CI so local dev and tests show no support link at all, in the
# footer or the Rules tab. Production sets this to
# https://buymeacoffee.com/bruchner.dev; see CLAUDE.md's Support link
# section for why this is a link and not the widget.
# VITE_SUPPORT_URL=
